{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rnitype-spike-overlay",
  "version": "0.1.0",
  "identifier": "dev.rnitype.spike.overlay",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RniType Spike B",
        "width": 720,
        "height": 420,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "center": true
      },
      {
        "label": "target",
        "url": "target.html",
        "title": "Spike B — target window",
        "width": 620,
        "height": 260,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}

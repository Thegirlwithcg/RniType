{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RniType",
  "mainBinaryName": "RniType",
  "version": "0.3.9",
  "identifier": "dev.rnitype.app",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "RniType",
    "copyright": "RniType",
    "category": "Utility",
    "shortDescription": "Type with a game controller",
    "longDescription": "RniType turns an Xbox/DualSense controller into a keyboard and mouse: 8x8 typing rings, command wheel, quick bar, mouse and Nav modes, per-app exclusions, per-cell keymaps and usage stats.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
